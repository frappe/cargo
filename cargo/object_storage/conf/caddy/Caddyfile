# Caddy passes Host through unchanged, which S3 needs: it signs Host into every request.
# Bodies stream both ways with no size cap. Buckets are addressed by path only, so a bucket
# in the hostname matches no site here.
s3-svc.${WILDCARD_DOMAIN} {
	# CORS is Garage's: each bucket carries its own allowed origins, and Garage answers the
	# browser's unsigned preflight from the bucket named in the path. The signature still
	# authorises each request; CORS only lets the browser send it and read the answer.
	reverse_proxy ${S3_UPSTREAM} {
		flush_interval -1
	}
}

s3-admin-svc.${WILDCARD_DOMAIN} {
	reverse_proxy ${ADMIN_UPSTREAM}
}
