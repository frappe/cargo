metadata_dir = "{{ metadata_dir }}"
data_dir     = "{{ data_dir }}"
db_engine    = "lmdb"

replication_factor = {{ replication_factor }}
consistency_mode   = "consistent"

rpc_bind_addr   = "{{ rpc_bind_addr }}:{{ rpc_port }}"
rpc_public_addr = "{{ rpc_public_addr }}:{{ rpc_port }}"
rpc_secret      = "{{ rpc_secret }}"

{# Filled on a second pass: a node's id is generated at first start, so peers are #}
{# unknowable until every node has run once. #}
bootstrap_peers = [
{%- for peer in bootstrap_peers %}
	"{{ peer }}",
{%- endfor %}
]

[s3_api]
s3_region     = "{{ region }}"
api_bind_addr = "{{ api_bind_addr }}:{{ s3_port }}"
root_domain   = ".s3.{{ region }}.{{ base_domain }}"

[s3_web]
bind_addr   = "{{ web_bind_addr }}:{{ web_port }}"
root_domain = ".web.{{ region }}.{{ base_domain }}"
index       = "index.html"

[k2v_api]
api_bind_addr = "{{ api_bind_addr }}:{{ k2v_port }}"

[admin]
api_bind_addr = "{{ api_bind_addr }}:{{ admin_port }}"
admin_token   = "{{ admin_token }}"
metrics_token = "{{ metrics_token }}"
