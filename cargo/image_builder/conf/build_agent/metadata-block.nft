#!/usr/sbin/nft -f
# Its own table, so podman's rules and a reload of this file never touch each other.
table inet deploy_agent
flush table inet deploy_agent

table inet deploy_agent {
	# Only containers and build steps, which reach the host through podman's bridge. Host processes keep the
	# metadata: sshd reads its authorized keys from it as nobody.
	chain forward {
		type filter hook forward priority filter - 10; policy accept;
		iifname "podman*" ip daddr 169.254.169.254 drop
	}
}
