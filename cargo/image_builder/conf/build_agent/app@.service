[Unit]
Description=App slot %i
Wants=network-online.target
After=network-online.target
# The app is user code, so it never starts without the metadata block.
Requires=metadata-block.service
After=metadata-block.service
# Ten restarts in five minutes, then the unit stays failed and the agent reports the app down.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# release.py writes IMAGE (app:<commit>), PORT (8001 for blue, 8002 for green) and the app's secrets before it
# starts a slot; the container gets the whole file.
EnvironmentFile=/var/lib/deploy-agent/slots/%i.env
ExecStartPre=-/usr/bin/podman rm --force --ignore app-%i
# Only nginx on the VM reaches the app, through loopback; nothing the container opens is public.
ExecStart=/usr/bin/podman run --rm --name app-%i --env-file /var/lib/deploy-agent/slots/%i.env --publish 127.0.0.1:${PORT}:${PORT} ${IMAGE}
ExecStop=/usr/bin/podman stop --time 30 app-%i
# systemd can kill --rm's removal once the app exits; a leftover container pins its image against pruning.
ExecStopPost=-/usr/bin/podman rm --force --ignore app-%i
TimeoutStopSec=45
# Every start is a fresh container from the image, so a crash or reboot loses writes outside mounts.
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
