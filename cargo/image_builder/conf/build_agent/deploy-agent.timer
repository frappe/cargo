[Unit]
Description=Ask Central for a build every 10 to 20 seconds

[Timer]
OnBootSec=10s
# Counted from when the last run ended, so a running build is never started twice.
OnUnitInactiveSec=10s
# A random 0-10s on every run, so VMs that booted together don't ask Central at once.
RandomizedDelaySec=10s
AccuracySec=1s

[Install]
WantedBy=timers.target
