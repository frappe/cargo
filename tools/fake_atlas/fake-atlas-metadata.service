[Unit]
Description=Fake Atlas instance metadata
After=network.target
Before=multi-user.target

[Service]
ExecStartPre=/usr/sbin/ip address replace 169.254.169.254/32 dev lo
ExecStart=/usr/bin/python3 /usr/local/lib/fake-atlas/metadata_server.py /var/lib/fake-atlas/metadata.json
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
